[user]
	email = synarete@gmail.com
	name = Shachar Sharon

[init]
	defaultBranch = main

[core]
	whitespace = trailing-space,space-before-tab
	editor = vim
	bigfilethreshold = 256k
	autocrlf = input
	# excludesfile = ${HOME}/.gitignore_global

[sendemail]
	from = Shachar Sharon <synarete@gmail.com>
	smtpserver = smtp.gmail.com
	smtpserverport = 587
	smtpencryption = tls
	smtpdomain = xxxxxx.net
	smtpuser = synarete@gmail.com
	suppresscc = all
	suppressfrom = no
	signedoffbycc = no
	chainreplyto = no

[push]
	default = simple

[branch]
	autosetuprebase = always
	sort = -committerdate

[tag]
        sort = version:refname

[diff]
	tool = vimdiff
	colormoved = "default"
	colormovedws = "allow-indentation-change"
        algorithm = histogram
        mnemonicprefix = true
        renames = true

[merge]
	conflictstyle = diff3
	tool = vimdiff

#[commit]
#        verbose = true

[log]
	decorate = short

[alias]
	st = status -sb
	br = branch
	df = diff
	co = checkout
	nb = checkout -b
	clean-fxd = clean -fxd
	add-commit = commit -a -s
	reset-head = reset --hard HEAD
	show-head = show -W HEAD
	ls = log --oneline --decorate
	ll = log --oneline --decorate --all --graph --date=iso --pretty
	lg = log --pretty=oneline --abbrev-commit --graph --decorate

[credential]
	helper = cache

[color]
	ui = auto
	branch = auto
	diff = auto
	status = auto

[color "grep"]
	linenumber = yellow bold
	match = red
	filename = magenta

[guitool "Rebase onto..."]
	cmd = git rebase
	revprompt = yes
[guitool "Rebase/Continue"]
	cmd = git rebase --continue
[guitool "Rebase/Skip"]
	cmd = git rebase --skip
[guitool "Rebase/Abort"]
	cmd = git rebase --abort
[guitool "Pull with Rebase"]
	cmd = git pull --rebase
