(use-modules (ice-9 getopt-long)
             (ice-9 popen)
             (ice-9 rdelim)
             (ice-9 regex)
             (ice-9 string-fun)
             (srfi srfi-1))

;;; ---------------------------------------------------------------------------
;;; ANSI color codes

(define ESC "\x1b[")

(define (ansi . codes)
  (string-append ESC (string-join (map number->string codes) ";") "m"))

(define RESET-ALL   (ansi 0))
(define DIM         (ansi 2))
(define BRIGHT      (ansi 1))
(define GREEN       (ansi 32))
(define YELLOW      (ansi 33))
(define RED         (ansi 31))
(define LIGHTRED-EX    (ansi 91))
(define LIGHTBLUE-EX   (ansi 94))
(define LIGHTGREEN-EX  (ansi 92))
(define LIGHTYELLOW-EX (ansi 93))
(define LIGHTMAGENTA-EX (ansi 95))

(define NLINES-DEFAULT 24)

;;; ---------------------------------------------------------------------------
;;; Utilities

(define (prog-name)
  (basename (car (program-arguments))))

(define (msg txt)
  (display (string-append (prog-name) ": " txt "\n")
           (current-error-port)))

(define (die txt)
  (msg txt)
  (exit 1))

(define (locate-bin name)
  (let ((found (search-path (parse-path (getenv "PATH")) name)))
    (unless found
      (die (string-append "failed to find " name)))
    found))

;;; ---------------------------------------------------------------------------
;;; String helpers

(define (string-contains-char? str ch)
  (string-index str ch))

(define (string-pad-right-to str width)
  "Pad STR with spaces on the right up to WIDTH."
  (let ((len (string-length str)))
    (if (>= len width)
        (substring str 0 width)
        (string-append str (make-string (- width len) #\space)))))

(define (split-on-sep str sep)
  "Split STR on SEP string, returning a list of parts."
  (let loop ((s str) (acc '()))
    (let ((idx (string-search-forward sep s 0)))
      (if (not idx)
          (reverse (cons s acc))
          (loop (substring s (+ idx (string-length sep)) (string-length s))
                (cons (substring s 0 idx) acc))))))

;;; ---------------------------------------------------------------------------
;;; Git log invocation

(define (git-log-format work-dir ref-name nlines)
  "Run git log and return raw output string."
  (let* ((git   (locate-bin "git"))
         (fmt   "--format=tformat:'%h|||%an|||%ad|||%d|||%s'")
         (args  (filter (lambda (s) (not (string=? s "")))
                        (list "--no-pager" "log"
                              "--abbrev-commit"
                              "--decorate"
                              "--date=short"
                              (string-append "-n" (number->string nlines))
                              fmt
                              ref-name)))
         (cmd   (string-join (cons git args) " "))
         (port  (open-input-pipe
                 (string-append "cd " work-dir " && " cmd)))
         (out   (let loop ((lines '()))
                  (let ((line (read-line port)))
                    (if (eof-object? line)
                        (string-join (reverse lines) "\n")
                        (loop (cons line lines))))))
         (status (close-pipe port)))
    (unless (eqv? 0 (status:exit-val status))
      (die (string-append "failed: " cmd)))
    out))

;;; ---------------------------------------------------------------------------
;;; Parsing

(define (parse-git-log-line ln)
  "Parse one git log line. Return list of 5 fields or #f."
  (let ((parts (split-on-sep ln "|||")))
    (if (= (length parts) 5)
        parts
        #f)))

(define (parse-git-log text)
  "Parse full git log output into a list of field-lists."
  (filter-map parse-git-log-line
              (string-split text #\newline)))

;;; ---------------------------------------------------------------------------
;;; Colorize decorations

(define (color-one-tag tag)
  "Return a colorized string for a single decoration TAG."
  (let ((ctag
         (cond
           ((string-index tag #\/)
            (string-append DIM LIGHTRED-EX tag))
           ((string-search-forward "HEAD" tag 0)
            (if (string-search-forward " -> " tag 0)
                (let* ((sp   (string-search-forward " " tag 0))
                       (head (substring tag 0 sp))
                       (tail (substring tag (+ sp 1) (string-length tag))))
                  (string-append BRIGHT LIGHTBLUE-EX
                                 head " " LIGHTGREEN-EX tail))
                (string-append BRIGHT LIGHTBLUE-EX tag)))
           ((string-search-forward "tag: " tag 0)
            (string-append LIGHTYELLOW-EX
                           (string-replace-substring tag "tag: " "")))
           (else
            (string-append LIGHTMAGENTA-EX tag)))))
    (string-append RESET-ALL ctag RESET-ALL)))

(define (color-branch-tags tag-token)
  "Colorize all decorations in TAG-TOKEN (the %d field from git log)."
  (let* ((stripped (string-trim-right
                    (string-trim tag-token)
                    #\)))
         (stripped (string-trim stripped #\())
         (raw-tags (string-split stripped #\,)))
    (if (or (string=? tag-token "")
            (null? raw-tags)
            (every (lambda (t) (string=? (string-trim t) "")) raw-tags))
        ""
        (let ((colored (map (lambda (t)
                              (color-one-tag (string-trim t)))
                            raw-tags)))
          (string-append "(" (string-join colored ", ") ") ")))))

;;; ---------------------------------------------------------------------------
;;; Printing

(define (print-gll-line sha author date tag-token commit-msg)
  (let* ((hsep  (string-append RED BRIGHT "|" RESET-ALL))
         (csha  (string-append GREEN sha))
         (cauth (string-append YELLOW (string-pad-right-to author 20)))
         (cdate (string-append LIGHTBLUE-EX date))
         (tags  (color-branch-tags tag-token))
         (cmsg  (string-append RESET-ALL commit-msg RESET-ALL))
         (tail  (string-append tags cmsg)))
    (display
     (string-append csha " " cauth " " cdate " " hsep " " tail "\n"))))

(define (print-gll gll-dat)
  (for-each
   (lambda (fields)
     (let ((ent (map string-trim fields)))
       (apply print-gll-line ent)))
   gll-dat))

;;; ---------------------------------------------------------------------------
;;; Argument parsing

(define option-spec
  '((help    (single-char #\h) (value #f))
    (nlines  (single-char #\n) (value #t))))

(define (usage exit-code)
  (display (string-append "usage: " (prog-name) " [-n NLINES] [<git-path>]\n"))
  (exit exit-code))

(define (parse-args)
  (let* ((opts    (getopt-long (program-arguments) option-spec
                               #:stop-at-first-non-option #t))
         (help?   (option-ref opts 'help #f))
         (nlines  (string->number
                   (option-ref opts 'nlines
                               (number->string NLINES-DEFAULT))))
         (rest    (option-ref opts '() '())))
    (when help? (usage 0))
    (when (> (length rest) 1) (usage 3))
    (let* ((work-dir (getcwd))
           (ref-name (if (null? rest) "" (car rest)))
           (work-dir (cond
                       ((and (not (string=? ref-name ""))
                             (file-is-directory? ref-name))
                        (canonicalize-path ref-name))
                       ((and (not (string=? ref-name ""))
                             (file-exists? ref-name))
                        (dirname (canonicalize-path ref-name)))
                       (else work-dir)))
           (ref-name (cond
                       ((string=? ref-name "") "")
                       ((file-is-directory? ref-name)
                        (canonicalize-path ref-name))
                       ((file-exists? ref-name)
                        (canonicalize-path ref-name))
                       (else ref-name))))
      (list work-dir ref-name nlines))))

;;; ---------------------------------------------------------------------------
;;; Entry point

(define (main)
  (let* ((args     (parse-args))
         (work-dir (car args))
         (ref-name (cadr args))
         (nlines   (caddr args)))
    (let* ((git-out (git-log-format work-dir ref-name nlines))
           (gll-dat (parse-git-log git-out)))
      (print-gll gll-dat))
    (exit 0)))

(main)
