{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "autoCompactThreshold": 75,
  "permissions": {
    "allow": [
      "Bash(./configure *)",
      "Bash(./cstylefmt.sh *)",
      "Bash(addr2line *)",
      "Bash(autoreconf *)",
      "Bash(awk *)",
      "Bash(clang-format *)",
      "Bash(clang-tidy *)",
      "Bash(cpp *)",
      "Bash(fd *)",
      "Bash(file *)",
      "Bash(gcc -E *)",
      "Bash(gdb *)",
      "Bash(git blame *)",
      "Bash(git branch)",
      "Bash(git describe *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git status)",
      "Bash(hexdump *)",
      "Bash(ldd *)",
      "Bash(make *)",
      "Bash(make)",
      "Bash(mkdir -p .scratch/*)",
      "Bash(mktemp -d .scratch/*)",
      "Bash(nm *)",
      "Bash(objdump *)",
      "Bash(pahole *)",
      "Bash(pkg-config *)",
      "Bash(readelf *)",
      "Bash(rg *)",
      "Bash(rm -r .scratch/*)",
      "Bash(sed *)",
      "Bash(size *)",
      "Bash(sort *)",
      "Bash(strace *)",
      "Bash(uniq *)",
      "Bash(valgrind *)",
      "Bash(xxd *)",
      "Read(//usr/include/**)",
      "Read(//usr/lib/gcc/x86_64-redhat-linux/**)",
      "Read(//usr/lib64/pkgconfig/**)",
      "Read(//usr/local/include/**)",
      "Read(//usr/share/aclocal/**)",
      "Read(//usr/share/autoconf/**)",
      "Read(//usr/share/automake-*/**)",
      "Read(//usr/share/libtool/**)",
      "Read(//usr/share/pkgconfig/**)",
      "Read(//usr/src/kernels/**)"
    ],
    "ask": [
      "Bash(make -f devel.mk reset*)"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Bash(chmod -R *)",
      "Bash(chown -R *)",
      "Bash(curl *)",
      "Bash(dd *)",
      "Bash(git add *)",
      "Bash(git am *)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git checkout *)",
      "Bash(git cherry-pick *)",
      "Bash(git clean *)",
      "Bash(git clone *)",
      "Bash(git commit *)",
      "Bash(git config *)",
      "Bash(git fetch *)",
      "Bash(git filter-branch *)",
      "Bash(git gc *)",
      "Bash(git merge *)",
      "Bash(git mv *)",
      "Bash(git notes *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git remote *)",
      "Bash(git replace *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git revert *)",
      "Bash(git rm *)",
      "Bash(git stash *)",
      "Bash(git submodule *)",
      "Bash(git switch *)",
      "Bash(git symbolic-ref *)",
      "Bash(git tag *)",
      "Bash(git update-index *)",
      "Bash(git update-ref *)",
      "Bash(git worktree *)",
      "Bash(mkfs*)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(pkexec *)",
      "Bash(rm -fr *)",
      "Bash(rm -rf *)",
      "Bash(rsync *)",
      "Bash(scp *)",
      "Bash(shred *)",
      "Bash(socat *)",
      "Bash(ssh *)",
      "Bash(su *)",
      "Bash(sudo *)",
      "Bash(wget *)",
      "Edit(**/Makefile)",
      "Edit(**/Makefile.in)",
      "Edit(**/common.mk)",
      "Edit(**/sedsub.mk)",
      "Edit(./.git/**)",
      "Edit(./aclocal.m4)",
      "Edit(./configure)",
      "Edit(./include/silofs/config.h.in)",
      "Edit(./libtool)",
      "Read(./.env*)",
      "Read(./.git/config)",
      "Read(./TAGS)",
      "Read(./aclocal.m4)",
      "Read(./build-aux/autom4te.cache/**)",
      "Read(./build-aux/config.guess)",
      "Read(./build-aux/config.sub)",
      "Read(./build-aux/ltmain.sh)",
      "Read(./libtool)",
      "Read(./m4/libtool.m4)",
      "Read(./m4/lt*.m4)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.ssh/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "enabled": true
  }
}
