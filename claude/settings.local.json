{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Read(/usr/include/**)",
      "Read(/usr/local/include/**)",
      "Bash(cat *.log)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(gcc -E*)",
      "Bash(cpp *)",
      "Bash(pkg-config*)",
      "Bash(autoreconf*)",
      "Bash(./configure*)",
      "Bash(make -j1)",
      "Bash(make check)",
      "Bash(valgrind *)",
      "Bash(gdb *)",
      "Bash(cppcheck *)",
      "Bash(clang-tidy *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git branch)",
      "Bash(git ls-files*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git rebase *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git merge *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git am *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(git clean *)",
      "Bash(git worktree *)",
      "Bash(git update-ref *)",
      "Bash(git filter-branch *)"
    ]
  },
  "autoCompactThreshold": 75
}
